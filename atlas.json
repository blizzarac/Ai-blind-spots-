---
layout: null
permalink: /atlas.json
---
{
  "name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "schema_version": "1.0.0",
  "generated": {{ site.time | date_to_xmlschema | jsonify }},
  "site": {{ site.url | append: site.baseurl | jsonify }},
  "categories": {
    {% for cat in site.data.categories %}{{ cat[0] | jsonify }}: {
      "title": {{ cat[1].title | jsonify }},
      "description": {{ cat[1].description | jsonify }}
    }{% unless forloop.last %},
    {% endunless %}{% endfor %}
  },
  "entries": [
    {% assign entries = site.blindspots | sort: "id" %}{% for e in entries %}{
      "id": {{ e.id | jsonify }},
      "title": {{ e.title | jsonify }},
      "category": {{ e.category | jsonify }},
      "severity": {{ e.severity | jsonify }},
      "detection": {{ e.detection | jsonify }},
      "models_affected": {{ e['models-affected'] | jsonify }},
      "added": {{ e.added | date: "%Y-%m-%d" | jsonify }},
      "last_reviewed": {{ e['last-reviewed'] | date: "%Y-%m-%d" | jsonify }},
      "summary": {{ e.summary | jsonify }},
      "url": {{ e.url | prepend: site.baseurl | prepend: site.url | jsonify }},
      "markdown_url": {{ e.id | prepend: "https://raw.githubusercontent.com/blizzarac/Ai-blind-spots-/main/_blindspots/" | append: ".md" | jsonify }},
      "sources": {{ e.sources | jsonify }},
      "body_text": {{ e.content | markdownify | strip_html | normalize_whitespace | jsonify }}
    }{% unless forloop.last %},
    {% endunless %}{% endfor %}
  ]
}
